        <!-- State: Cart -->
        <mxCell id="state_cart" value="CART&#xa;[Items selected, stock checked]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#C8E6C9;strokeColor=#4CAF50;strokeWidth=1.5;fontStyle=1;fontSize=10;fontColor=#1B5E20;align=center;" vertex="1" parent="sm_retail">
          <mxGeometry x="195" y="110" width="170" height="50" as="geometry" />
        </mxCell>

        <!-- State: Placed -->
        <mxCell id="state_placed" value="PLACED&#xa;[Order created, stock reserved]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#C8E6C9;strokeColor=#4CAF50;strokeWidth=1.5;fontStyle=1;fontSize=10;fontColor=#1B5E20;align=center;" vertex="1" parent="sm_retail">
          <mxGeometry x="195" y="220" width="170" height="50" as="geometry" />
        </mxCell>

        <!-- State: Processing -->
