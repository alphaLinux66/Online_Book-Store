          <mxGeometry x="195" y="340" width="170" height="50" as="geometry" />
        </mxCell>

        <!-- State: Shipped -->
        <mxCell id="state_shipped" value="SHIPPED&#xa;[Dispatched, tracking code assigned]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#C8E6C9;strokeColor=#4CAF50;strokeWidth=1.5;fontStyle=1;fontSize=10;fontColor=#1B5E20;align=center;" vertex="1" parent="sm_retail">
          <mxGeometry x="195" y="470" width="170" height="50" as="geometry" />
        </mxCell>

        <!-- State: Delivered -->
        <mxCell id="state_delivered" value="DELIVERED&#xa;[Receipt confirmed, reviews open]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#C8E6C9;strokeColor=#4CAF50;strokeWidth=1.5;fontStyle=1;fontSize=10;fontColor=#1B5E20;align=center;" vertex="1" parent="sm_retail">
