        <!-- Retail Transitions -->
        <mxCell id="t_r1" value="Initialize cart" style="endArrow=block;html=1;strokeColor=#2E7D32;strokeWidth=1.2;fontSize=9;fontColor=#2E7D32;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="sm_retail" source="r_start" target="state_cart">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="t_r2" value="post('api/checkout/') /&#xa;[stock verified]" style="endArrow=block;html=1;strokeColor=#2E7D32;strokeWidth=1.2;fontSize=9;fontColor=#2E7D32;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="sm_retail" source="state_cart" target="state_placed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="t_r3" value="payment_success() /&#xa;[amount paid]" style="endArrow=block;html=1;strokeColor=#2E7D32;strokeWidth=1.2;fontSize=9;fontColor=#2E7D32;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="sm_retail" source="state_placed" target="state_processing">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="t_r4" value="ship_order() /&#xa;[carrier assigned]" style="endArrow=block;html=1;strokeColor=#2E7D32;strokeWidth=1.2;fontSize=9;fontColor=#2E7D32;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="sm_retail" source="state_processing" target="state_shipped">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="t_r5" value="delivery_confirmed() /&#xa;[arrived at customer]" style="endArrow=block;html=1;strokeColor=#2E7D32;strokeWidth=1.2;fontSize=9;fontColor=#2E7D32;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="sm_retail" source="state_shipped" target="state_delivered">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="t_r6" value="Archive / complete" style="endArrow=block;html=1;strokeColor=#2E7D32;strokeWidth=1.2;fontSize=9;fontColor=#2E7D32;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="sm_retail" source="state_delivered" target="r_end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Cancel Transitions -->
        <mxCell id="t_c1" value="payment_failed() or&#xa;cancel_order()" style="endArrow=block;html=1;strokeColor=#E53935;strokeWidth=1.2;fontSize=9;fontColor=#B71C1C;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="sm_retail" source="state_placed" target="state_cancelled">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="90" y="245" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="t_c2" value="refund_initiated()" style="endArrow=block;html=1;strokeColor=#E53935;strokeWidth=1.2;fontSize=9;fontColor=#B71C1C;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="sm_retail" source="state_processing" target="state_cancelled">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="t_c3" value="Close order" style="endArrow=block;html=1;strokeColor=#E53935;strokeWidth=1.2;fontSize=9;fontColor=#B71C1C;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="sm_retail" source="state_cancelled" target="r_end">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="90" y="745" />
            </Array>
          </mxGeometry>
        </mxCell>


        <!-- STATE MACHINE 2: B2B BULK ORDER & INVENTORY SYNC LIFECYCLE -->
        <mxCell id="sm_b2b" value="B2B Bulk Order State Machine" style="swimlane;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=2;fontColor=#E65100;" vertex="1" parent="1">
          <mxGeometry x="680" y="80" width="580" height="840" as="geometry" />
        </mxCell>

        <!-- Initial State -->
        <mxCell id="b_start" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#E65100;strokeColor=none;" vertex="1" parent="sm_b2b">
          <mxGeometry x="280" y="50" width="20" height="20" as="geometry" />
        </mxCell>

        <!-- State: Pending -->
        <mxCell id="state_pending" value="PENDING&#xa;[Admin places wholesale order,&#xa;invoice generated, supplier notified]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFE0B2;strokeColor=#FF9800;strokeWidth=1.5;fontStyle=1;fontSize=10;fontColor=#E65100;align=center;" vertex="1" parent="sm_b2b">
          <mxGeometry x="195" y="120" width="190" height="60" as="geometry" />
        </mxCell>

        <!-- State: Shipped -->
        <mxCell id="state_b2b_shipped" value="SHIPPED&#xa;[Supplier dispatches cargo,&#xa;SupplierBook inventory deducted]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFE0B2;strokeColor=#FF9800;strokeWidth=1.5;fontStyle=1;fontSize=10;fontColor=#E65100;align=center;" vertex="1" parent="sm_b2b">
          <mxGeometry x="195" y="270" width="190" height="60" as="geometry" />
        </mxCell>

        <!-- State: Delivered -->
        <mxCell id="state_b2b_delivered" value="DELIVERED&#xa;[Sync Event: Stock added/created&#xa;in retail Book database table]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFE0B2;strokeColor=#FF9800;strokeWidth=1.5;fontStyle=1;fontSize=10;fontColor=#E65100;align=center;" vertex="1" parent="sm_b2b">
          <mxGeometry x="195" y="440" width="190" height="60" as="geometry" />
        </mxCell>

        <!-- Final State -->
