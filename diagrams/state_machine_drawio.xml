          <mxGeometry x="275" y="590" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- B2B Transitions -->
        <mxCell id="t_b1" value="Admin triggers bulk checkout" style="endArrow=block;html=1;strokeColor=#FF9800;strokeWidth=1.2;fontSize=9;fontColor=#E65100;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="sm_b2b" source="b_start" target="state_pending">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="t_b2" value="patch('api/bulk-orders/{id}/status/', status='Shipped') /&#xa;[internal supplier stock validation]" style="endArrow=block;html=1;strokeColor=#FF9800;strokeWidth=1.2;fontSize=9;fontColor=#E65100;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="sm_b2b" source="state_pending" target="state_b2b_shipped">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="t_b3" value="patch('api/bulk-orders/{id}/status/', status='Delivered') /&#xa;[Trigger: loop items, sync with retail catalog Book model]" style="endArrow=block;html=1;strokeColor=#FF9800;strokeWidth=1.2;fontSize=9;fontColor=#E65100;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="sm_b2b" source="state_b2b_shipped" target="state_b2b_delivered">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="t_b4" value="Transaction archived" style="endArrow=block;html=1;strokeColor=#FF9800;strokeWidth=1.2;fontSize=9;fontColor=#E65100;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="sm_b2b" source="state_b2b_delivered" target="b_end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
